{
  "name": "krazyidle",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Échos de Lignée — idle game dynastique à boucles temporelles",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "node --import ./lab/sim/register.mjs lab/sim/cli.ts",
    "sim:compare": "node --import ./lab/sim/register.mjs lab/sim/compare.ts",
    "sim:guard": "node --import ./lab/sim/register.mjs lab/metrics/guardrails.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
